{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-9abb155d-60e2-4ff1-a8d0-bfd467e08f25"
      }
    },
    "duckduckgo": {
      "type": "local",
      "command": ["npx", "-y", "duckduckgo-websearch"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "mcp-fetch-server"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/juan"],
      "enabled": true
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "AQ.Ab8RN6LutqbVBalLxaj8GQpqqS2BNqkwXR70_vzd9xPRAqTkaQ"
      }
    }
  }
}
