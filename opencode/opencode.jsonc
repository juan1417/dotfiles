{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "transparent_background": true
  },
  "agent": {
    "project-planner": {
      "mode": "primary",
      "description": "Director de Planificación de Proyectos. Analiza requerimientos, valida stack tecnológico, crea planificación ágil (Scrum/Kanban) y genera project-plan.md completo con validación automática.",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "stack-validator": {
      "mode": "subagent",
      "description": "Valida y recomienda stack tecnológico para proyectos de software",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "agile-validator": {
      "mode": "subagent",
      "description": "Crea y valida planificación ágil (Scrum/Kanban) para proyectos",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "feasibility-checker": {
      "mode": "subagent",
      "description": "Valida viabilidad y coherencia de planes de proyecto",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "sdd-orchestrator": {
      "mode": "primary",
      "description": "Orquestador SDD - coordina sub-agentes, nunca ejecuta trabajo directo",
      "systemPrompt": "{file:./agents/sdd-orchestrator.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "allow"
      }
    },
    "sdd-explore": {
      "mode": "subagent",
      "hidden": true,
      "description": "Explora el codebase y analiza ideas",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "sdd-spec": {
      "mode": "subagent",
      "hidden": true,
      "description": "Escribe especificaciones detalladas",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "sdd-design": {
      "mode": "subagent",
      "hidden": true,
      "description": "Crea diseño técnico",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "sdd-tasks": {
      "mode": "subagent",
      "hidden": true,
      "description": "Planifica tareas de implementación",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "sdd-apply": {
      "mode": "subagent",
      "hidden": true,
      "description": "Implementa cambios de código",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "sdd-verify": {
      "mode": "subagent",
      "hidden": true,
      "description": "Verifica implementación contra specs",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    }
  },
  "lsp": true,
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  }
}
