{
  "$schema": "https://opencode.ai/config.json",
  
  // ============================================
  // CONFIGURACIÓN DE AGENTES, SKILLS Y PLUGINS
  // ============================================
  // MCP se configura en: opencode.json
  
  "tui": {
    "transparent_background": true
  },
  
  // ============================================
  // SKILLS
  // ============================================
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  
  // ============================================
  // AGENTES
  // ============================================
  "agent": {
    // === MODOS PRINCIPALES ===
    "sdd-orchestrator": {
      "mode": "primary",
      "description": "Orquestador SDD - coordina sub-agentes, nunca ejecuta trabajo directo. Modo principal de trabajo.",
      "systemPrompt": "{file:./agents/sdd-orchestrator.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "sdd-planning": {
      "mode": "primary",
      "description": "SDD Planning - Analiza requerimientos, crea historias de usuario, gestiona backlog y planifica proyecto. Al finalizar, conserva solo: planning.md, roadmap.md, backlog.md y documentación en Obsidian.",
      "systemPrompt": "{file:./subagents/pm.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    
    // === SUB-AGENTES (llamados por los modos principales) ===
    "po": {
      "mode": "subagent",
      "description": "Product Owner - Crea historias de usuario y gestiona backlog",
      "systemPrompt": "{file:./subagents/po.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "task": "deny"
      }
    },
    "architect": {
      "mode": "subagent",
      "description": "Architect - Diseña arquitectura y selecciona tecnologías",
      "systemPrompt": "{file:./subagents/architect.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "task": "deny"
      }
    },
    "developer": {
      "mode": "subagent",
      "description": "Developer - Implementa código según especificaciones",
      "systemPrompt": "{file:./subagents/developer.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "deny"
      }
    },
    "backend-dev": {
      "mode": "subagent",
      "description": "Backend Developer - Desarrollo de APIs, lógica de negocio, bases de datos e integraciones del servidor",
      "systemPrompt": "{file:./subagents/backend-dev.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "deny"
      }
    },
    "frontend-dev": {
      "mode": "subagent",
      "description": "Frontend Developer - Desarrollo de interfaces de usuario, componentes React/Vue/Angular y experiencia de usuario",
      "systemPrompt": "{file:./subagents/frontend-dev.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "deny"
      }
    },
    "e2e-tester": {
      "mode": "subagent",
      "description": "E2E Tester - Testing end-to-end con Playwright, validación de flujos de usuario completos y detección de bugs de integración",
      "systemPrompt": "{file:./subagents/e2e-tester.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "deny"
      }
    },
    "qa": {
      "mode": "subagent",
      "description": "QA - Garantiza calidad mediante pruebas",
      "systemPrompt": "{file:./subagents/qa.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "deny"
      }
    },
    "qc": {
      "mode": "subagent",
      "description": "QC - Audita código y reporta deuda técnica",
      "systemPrompt": "{file:./subagents/qc.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "task": "deny"
      }
    },
    "devops": {
      "mode": "subagent",
      "description": "DevOps - Gestiona CI/CD y despliegues",
      "systemPrompt": "{file:./subagents/devops.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "deny"
      }
    },
    "scrum-master": {
      "mode": "subagent",
      "description": "Scrum Master - Facilita ceremonias y remueve impedimentos",
      "systemPrompt": "{file:./subagents/scrum-master.md}",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "task": "deny"
      }
    }
  },
  
  // LSP habilitado
  "lsp": true
}
