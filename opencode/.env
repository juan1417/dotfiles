# ============================================
# Configuración de MCP Servers
# ============================================
# Copia este archivo como .env y configura tus credenciales

# --------------------------------------------
# GitHub MCP
# --------------------------------------------
# Obtén tu token en: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=tu-github-token-aqui

# --------------------------------------------
# Vercel MCP
# --------------------------------------------
# Obtén tu token en: https://vercel.com/account/tokens
VERCEL_TOKEN=tu-vercel-token-aqui

# --------------------------------------------
# Neon MCP
# --------------------------------------------
# Obtén tu API key en: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=tu-neon-api-key-aqui

# --------------------------------------------
# Appium MCP (Opcional)
# --------------------------------------------
# Configuración por defecto
APPIUM_HOST=localhost
APPIUM_PORT=4723

# --------------------------------------------
# OpenDesign MCP (Opcional)
# --------------------------------------------
# Las credenciales de OpenDesign son opcionales
# OPENDESIGN_API_KEY=tu-opendesign-api-key-aqui
# OPENDESIGN_PROJECT_ID=tu-opendesign-project-id-aqui

# ============================================
# Notas Importantes
# ============================================
# 1. Nunca subas este archivo a control de versiones
# 2. Agrega .env a tu archivo .gitignore
# 3. Solo necesitas configurar los MCP que vayas a usar
# 4. Los MCP funcionan sin credenciales para funcionalidad básica
