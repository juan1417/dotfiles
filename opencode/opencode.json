{
  "$schema": "https://opencode.ai/config.json",
  
  // ============================================
  // CONFIGURACIÓN DE MCP SERVERS
  // ============================================
  // Agentes, skills y plugins: opencode.jsonc
  
  "mcp": {
    // === ALMACENAMIENTO ===
    "codebase-memory": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
      "enabled": true
    },
    
    // === DOCUMENTACIÓN ===
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    
    // === DISEÑO ===
    "open-design": {
      "type": "local",
      "command": ["node", "C:\\Users\\juani\\AppData\\Roaming\\Open Design\\launcher\\channels\\stable\\namespaces\\release-stable-win\\versions\\0.19.2\\payload\\resources\\app\\prebundled\\daemon\\daemon-cli.mjs", "mcp"],
      "env": {
        "ELECTRON_RUN_AS_NODE": "1",
        "OD_DATA_DIR": "C:\\Users\\juani\\AppData\\Roaming\\Open Design\\namespaces\\release-stable-win\\data",
        "OD_SIDECAR_IPC_PATH": "\\\\.\\pipe\\open-design-release-stable-win-daemon"
      },
      "enabled": true
    },
    
    // === CONTROL DE VERSIONES ===
    "github": {
      "type": "local",
      "command": ["gh", "mcp", "start"],
      "enabled": true
    },
    
    // === DEPLOYMENT ===
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    
    // === BASE DE DATOS ===
    "Neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "enabled": true
    },
    
    // === TESTING ===
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--browser", "msedge"],
      "enabled": true
    },
    "appium": {
      "type": "local",
      "command": ["npx", "-y", "appium-mcp@latest"],
      "env": {
        "APPIUM_HOST": "localhost",
        "APPIUM_PORT": "4723"
      },
      "enabled": true
    }
  }
}
