{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "custom/media-prev",
        "custom/media-play",
        "custom/media-next",
        "custom/media-title"
    ],
    "modules-right": [
        "tray",
        "bluetooth",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "clock"
    ],
    "hyprland/workspaces": {
        "format": "●",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false,
        "all-outputs": false,
        "format-icons": {
            "active": "●",
            "default": "●"
        }
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 30,
        "separate-outputs": true
    },
    "custom/media-prev": {
        "format": "\u23EE",
        "on-click": "playerctl previous",
        "tooltip": false
    },
    "custom/media-play": {
        "exec": "~/.config/waybar/scripts/media-play.sh",
        "format": "{}",
        "on-click": "playerctl play-pause",
        "tooltip": false,
        "interval": 1
    },
    "custom/media-next": {
        "format": "\u23ED",
        "on-click": "playerctl next",
        "tooltip": false
    },
    "custom/media-title": {
        "format": "{text}",
        "return-type": "json",
        "max-length": 40,
        "exec": "playerctl metadata --format '{\"text\": \"{{ artist }} - {{ title }}\"}' 2>/dev/null || echo '{\"text\": \"\"}'",
        "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
        "tooltip": false,
        "interval": 1
    },
    "clock": {
        "format": " \uF017 {:%H:%M  %d/%m/%y}",
        "interval": 1,
        "on-click": "bash /home/juan/.config/waybar/scripts/calendar.sh"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "\uF240 {capacity}%",
        "format-charging": "\uF0E7 {capacity}%",
        "tooltip-format": "{timeTo}\n{capacity}%"
    },
    "network": {
        "format-wifi": "\uF1EB {signalStrength}%",
        "format-ethernet": "\uF0AC {ipaddr}",
        "format-disconnected": "\uF127",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
    },
    "bluetooth": {
        "format-disabled": "\uF127",
        "format-off": "\uF127",
        "format-on": "\uF127 {device_alias}",
        "tooltip-format-enumerate-connected": "{device_enumerate}",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh"
    },
    "pulseaudio": {
        "format": "\uF028 {volume}%",
        "format-muted": "\uF131",
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}\n{volume}%"
    },
    "backlight": {
        "format": "\uF185 {percent}%",
        "tooltip-format": "Brightness: {percent}%"
    },
    "tray": {
        "spacing": 8,
        "show-passive-items": true
    }
}
